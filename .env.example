FIN_LLM_BASE_URL=http://localhost:8008/v1
FIN_LLM_API_KEY=EMPTY
FIN_LLM_TEMPERATURE=0.2

# Optional overrides
# FIN_DATA_DIR=./data
# FIN_DB_DIR=./db

# Set this in production to require X-API-Key on every request
# FIN_API_KEY=change-me

# Comma-separated list of API keys granted cross-tenant (admin) access.
# Holders can list all tenants and query across multiple/all tenants.
# Leave unset to disable the admin view entirely.
# FIN_ADMIN_API_KEYS=admin-key-1,admin-key-2

